# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Local only. Do not paste these two onto Railway — they cause DisallowedHost
# and the Django debug page on the public URL.
DJANGO_SETTINGS_MODULE=config.settings.local

# Database — Supabase Postgres only (session pooler). Tests use config.settings.test.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Data API (HTTPS PostgREST / Auth). Publishable key from Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_...

# Redis / Celery — local runserver. docker compose overrides this to redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# CSRF / security (production)
CSRF_TRUSTED_ORIGINS=
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DREAMLENS_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# DreamDEX integration — live on-chain / indexer by default
MOCK_DREAMDEX=false
DREAMDEX_NETWORK=testnet
DREAMDEX_CHAIN_ID=50312
DREAMDEX_RPC_URL=https://api.infra.testnet.somnia.network
DREAMDEX_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Starting venue id — if empty markets appear, read venueId from a live Market row
DREAMDEX_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
DREAMDEX_EVENT_SYNC_INTERVAL=60
DREAMDEX_COLLATERAL_DECIMALS=6
DREAMDEX_TICK=1000
DREAMDEX_LOT=1000

# Optional DreamDEX contract overrides
DREAMDEX_BINARY_MODULE=
DREAMDEX_COLLATERAL=

# LLM (AI Lens) — OpenRouter Ling 3 Flash is primary. Ollama is fallback.
LLM_PROVIDER=openrouter
LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REASONING=true
LLM_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local LLM fallback (Ollama / LM Studio / vLLM)
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://192.168.0.110:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=llama3.2

# MetaMask Smart Accounts / DreamAgent — live Shannon only
# Tests force MOCK_SMART_ACCOUNT=true in tests/conftest.py. Runtime must stay false.
MOCK_SMART_ACCOUNT=false
# Addresses from scripts/metamask/spike_deploy_and_trade.mjs (SKIP_TRADE=1)
METAMASK_DELEGATION_MANAGER=
METAMASK_SIMPLE_FACTORY=
METAMASK_HYBRID_IMPL=
METAMASK_ENTRY_POINT=
# Backend session EOA for redeemDelegations (NOT the user's MetaMask key)
DREAM_AGENT_SESSION_KEY=
DREAM_AGENT_GAS_LIMIT=800000
# Smart Account reimburses session-key gas in STT on each redeem
DREAM_AGENT_SA_PAYS_GAS=true
DREAM_AGENT_GAS_BUFFER_BPS=2500
DREAM_AGENT_MAX_GAS_PAYMENT_WEI=50000000000000000

# Telegram bot — BotFather token. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Never store the user's MetaMask private key in DreamLens
# PRIVATE_KEY=
